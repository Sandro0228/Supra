{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/edit/:id",
      "destination": "/app"
    },
    {
      "source": "/e/:slug",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/assets.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}