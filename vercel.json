{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/edit/:id",
      "destination": "/app"
    },
    {
      "source": "/e/:slug",
      "destination": "/app"
    },
    {
      "source": "/r/:token",
      "destination": "/app"
    },
    {
      "source": "/account",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
